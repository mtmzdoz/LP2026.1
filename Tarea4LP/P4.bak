#lang scheme

(define (hash-desconexion token)
  ;;P4, plegar(sumar) toda la lista numérica anterior, empezando en 0
  (foldl + 0
         
         ;;P3, se transforma la lista de letras a su valor númerico (ascii)
         (map char->integer
              
              ;;P2, se elimina lo que no sean letras del alfabeto
              (filter char-alphabetic?
                      
                      ;;P1, texto inicial se convierte a una lista de caracteres
                      (string->list token)))))


;; Ejemplo 1: Token con letras, símbolos y números.
(hash-desconexion "N!u1lS#e*c")
;; R: 586

;; Ejemplo 2: Token puramente corrupto (sin letras).
(hash-desconexion "12345!@#$")
;; R: 0

;; Ejemplo 3: Un token relativamente limpio.
(hash-desconexion "A-B-C")
;; R: 198